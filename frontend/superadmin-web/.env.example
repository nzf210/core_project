# =============================================================================
# superadmin-web — Environment Variables
# =============================================================================
# CARA PAKAI:
#   Development : cp .env.example .env.local  → otomatis di-load Vite
#   Staging/Prod: set via GitHub Secrets di workflow CI/CD
#                 TIDAK perlu file .env di server — Vite bake saat build
# =============================================================================

# URL API backend (API Gateway)
# Development : http://localhost:8000
# Staging     : https://api-stg.yourdomain.com
# Production  : https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# URL Grafana dashboard (ditampilkan di navbar superadmin)
# Development : http://localhost:3001
# Staging     : https://grafana-stg.yourdomain.com
# Production  : https://grafana.yourdomain.com
VITE_GRAFANA_URL=http://localhost:3001
