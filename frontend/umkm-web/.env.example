# =============================================================================
# umkm-web — Environment Variables
# =============================================================================
# CARA PAKAI:
#   Development : cp .env.example .env.local  → otomatis di-load Vite
#   Staging/Prod: set via GitHub Secrets (VITE_API_URL) di workflow CI/CD
#                 TIDAK perlu file .env di server — Vite bake saat build
# =============================================================================

# URL API backend (API Gateway)
# Development : http://localhost:8000
# Staging     : https://api-stg.yourdomain.com
# Production  : https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
