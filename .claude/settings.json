{
  "permissions": {
    "allow": [
      "Bash: go build ./...",
      "Bash: go vet ./...",
      "Bash: go test ./...",
      "Bash: gofmt -l .",
      "Bash: go mod tidy",
      "Bash: make build-all",
      "Bash: make start-all",
      "Bash: make stop-all",
      "Bash: git add",
      "Bash: git commit",
      "Bash: git push",
      "Bash: git checkout -b",
      "Bash: git diff --name-only",
      "Bash: git log --oneline -20",
      "Bash: gh pr create",
      "Bash: gh pr comment",
      "Bash: gh pr view",
      "Bash: docker compose up -d",
      "Bash: docker compose down",
      "Bash: docker compose ps",
      "Bash: ls -la",
      "Bash: mkdir -p",
      "Bash: chmod +x",
      "Bash: curl -s",
      "Bash: ps aux | grep",
      "Bash: kill"
    ],
    "deny": [
      "Bash: rm -rf /",
      "Bash: dd if=.*of=.*bs=.*count=.*",
      "Bash: mkfs",
      "Bash: git push --force",
      "Bash: git reset --hard"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true,
    "sonarqube@claude-plugins-official": true
  },
  "max-contextualization-length": 1000
}
