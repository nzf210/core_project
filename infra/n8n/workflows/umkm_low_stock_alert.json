{
  "name": "UMKM Low Stock Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "umkm/alerts/low-stock",
        "options": {}
      },
      "id": "e1f1c7d3-98a2-4f1a-b6e5-4d5c6f7e8a9b",
      "name": "Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "umkm-low-stock"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WA_GATEWAY_URL }}/api/wa/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.body.owner_phone }}"
            },
            {
              "name": "message",
              "value": "=⚠️ *LOW STOCK ALERT*\n\nBos, barang *{{ $json.body.product_name }}* sisa *{{ $json.body.current_stock }}* pcs.\n\nBuruan restock sebelum habis!"
            }
          ]
        },
        "options": {}
      },
      "id": "c3e5d7f1-28b4-4e1c-b5e5-4d5c6f7e8a9c",
      "name": "WA Gateway Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook Receiver": {
      "main": [
        [
          {
            "node": "WA Gateway Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "wch-umkm-001"
  }
}
