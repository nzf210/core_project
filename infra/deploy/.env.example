# ==========================================
# WCH Platform Environment Configuration Example
# ==========================================

# Core Server Settings
PORT=8080
ENV=development # development | production
JWT_SECRET=your_32_character_super_secret_jwt_key_here
ENCRYPTION_KEY=aes_256_key_for_api_keys_must_be_32_bytes

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wch_admin
DB_PASSWORD=secure_postgres_password_123
DB_NAME=wch_platform
DB_SSLMODE=disable

# Cache Configuration (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_123

# AI APIs Settings
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MiniMax M2.7 — PRIMARY LLM for all WCH Platform products
# Get your key at: https://platform.minimax.io/
MINIMAX_API_KEY=your_minimax_api_key_from_platform_minimax_io
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# AI Cost & Cache Settings
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=600
AI_COST_ALERT_USD=10.00

# WhatsApp Gateway (Third-Party: Fonnte)
FONNTE_TOKEN=your_fonnte_api_token_here

# Payment & Billing Integration
XENDIT_API_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notification SMTP settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@wchplatform.com
SMTP_PASS=smtp_secure_password_abc
