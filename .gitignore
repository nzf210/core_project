# =============================================================================
# WCH Platform — .gitignore
# =============================================================================

# Environment Variables (JANGAN pernah commit ini!)
.env
.env.*
!.env.example
!.env.staging.example
*.bin
# =============================================================================
# Go Artifacts — Compiled Binaries
# =============================================================================
# Binaries yang mungkin ter-build ke root secara tidak sengaja
/accounting
/billing-service
/auth-service
/api-gateway
/ai-gateway
/umkm-accounting
/umkm-business
/umkm-chatbot
/crypto-api
/crypto-worker
/campaign-api
/wa-gateway
/notification-service

# bin/ — Local build output (binary go build)
# Ignore semua isi bin/ kecuali .gitkeep
bin/*
!bin/.gitkeep

# =============================================================================
# Logs — Disimpan di logs/
# =============================================================================
# Ignore semua isi logs/ kecuali .gitkeep
logs/*
!logs/.gitkeep
# Legacy safety: *.log di mana saja di root
/*.log

# =============================================================================
# PID Files — Disimpan di run/
# =============================================================================
# Ignore semua isi run/ kecuali .gitkeep
run/*
!run/.gitkeep
# Legacy safety: *.pid di mana saja di root
/*.pid

# =============================================================================
# Frontend
# Frontend
node_modules/
.next/
dist/
.nuxt/
.vite/
*.tsbuildinfo
frontend/*/dist/
frontend/*/node_modules/
frontend/*/.vite/
frontend/*/.nuxt/

# =============================================================================
# Python (tools/scripts)
# =============================================================================
scripts/revenue_simulation/
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/

# =============================================================================
# Uploads (file yang di-upload user — jangan commit ke git!)
# =============================================================================
uploads/

# =============================================================================
# Temporary Files & Legacy
# =============================================================================
# Folder untuk temporary/legacy files yang akan dihapus
temp/
*.tar.gz
*.zip
*.dump

# =============================================================================
# OS & Editor
# =============================================================================
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
chatbot
# Negate umkm chatbot source directory (chatbot pattern above ignores legacy builds/outputs)
!apps/umkm/chatbot/
subscription-worker
temp.md
business
# Negate umkm business source directory (business pattern above ignores legacy builds/outputs)
!apps/umkm/business/
api
# Negate campaign API source directory (api pattern above is legacy leftover)
!apps/campaign/api/
auto-bin
