# =============================================================================
# WCH Platform — Environment Variables Template
# =============================================================================
# CARA PAKAI:
#   cp .env.example .env
#   Isi nilai yang sesuai di .env
#   JANGAN commit file .env ke git!
# =============================================================================

# =============================================================================
# Core Security (WAJIB diganti sebelum production!)
# =============================================================================
APP_ENV=development                          # development | production
JWT_SECRET=ganti_ini_dengan_32_karakter_random_aman
ENCRYPTION_KEY=ganti_ini_dengan_32_karakter_random_aman

# Superadmin Default Password
# Username: superadmin | Email: superadmin@internal
SUPERADMIN_PASSWORD=superadmin123            # WAJIB diganti di production!

# =============================================================================
# Database — PostgreSQL
# =============================================================================
# Local (docker-compose expose ke port 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=wch_admin
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=wch_platform
DB_SSLMODE=disable

# =============================================================================
# Cache — Redis
# =============================================================================
# Local (docker-compose expose ke port 6381)
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=ganti_dengan_password_kuat

# =============================================================================
# AI / LLM Gateway — 3-Tier Fallback LLM Configuration
# =============================================================================
# Format: Setiap provider bisa punya multiple models (semicolon-separated)
# Fallback chain: Primary → Fallback1 → Fallback2 → Fallback3
#
# Format fallback: "provider:model" (contoh: "gemini:gemini-1.5-flash")
# =============================================================================

# TIER 1: Primary LLM (Anthropic - fokus saat ini)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.Anthropic.io/v1
# Multiple models (semicolon-separated): main model;fast model;cheap model
MINIMAX_MODELS=claude-sonnet-4-5
MINIMAX_CAPABILITIES=general,product,faq
MINIMAX_CONTEXT_WINDOW=1000000
MINIMAX_COST_PER_1M_IN=0.30
MINIMAX_COST_PER_1M_OUT=1.20
# 3-Tier Fallback Chain (max 3 levels)
MINIMAX_FALLBACK_1=gemini:gemini-1.5-flash
MINIMAX_FALLBACK_2=openai:gpt-4o-mini
MINIMAX_FALLBACK_3=

# TIER 2: Secondary LLM (OpenAI - untuk coding & specialized tasks)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o;gpt-4o-mini
OPENAI_CAPABILITIES=general,coding
OPENAI_CONTEXT_WINDOW=128000;200000
OPENAI_COST_PER_1M_IN=5.00;0.15
OPENAI_COST_PER_1M_OUT=15.00;0.60
OPENAI_FALLBACK_1=gemini:gemini-1.5-flash
OPENAI_FALLBACK_2=Anthropic:claude-sonnet-4-5
OPENAI_FALLBACK_3=

# TIER 3: Fallback LLM (Gemini - last resort, free tier available)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-1.5-flash;gemini-2.0-flash
GEMINI_CAPABILITIES=general,vision
GEMINI_CONTEXT_WINDOW=1000000;2000000
GEMINI_COST_PER_1M_IN=0.075;0
GEMINI_COST_PER_1M_OUT=0.30;0
GEMINI_FALLBACK_1=
GEMINI_FALLBACK_2=
GEMINI_FALLBACK_3=

# AI Caching via Redis
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=600

# Contoh: Custom API Base URL untuk self-hosted models
# OPENAI_BASE_URL=https://your-llm-server.com/v1
# MINIMAX_BASE_URL=https://your-custom-endpoint.com/v1

# Contoh: Multi-model setup untuk cost optimization
# MINIMAX_MODELS=claude-sonnet-4-5;claude-sonnet-4-5-Fast
# MINIMAX_CAPABILITIES=general,product,faq;general
# MINIMAX_COST_PER_1M_IN=0.30;0.10
# MINIMAX_COST_PER_1M_OUT=1.20;0.40
# MINIMAX_FALLBACK_1=gemini:gemini-1.5-flash
# MINIMAX_FALLBACK_2=openai:gpt-4o-mini
# MINIMAX_FALLBACK_3=

# =============================================================================
# WhatsApp Gateway
# =============================================================================
# Self-hosted WA gateway (whatsmeow-based, port 8202).
# Tenant connect via scan QR — lihat docs/WHATSAPP_GATEWAY_PLAN.md.
WA_GATEWAY_URL=http://wa-gateway:8202

# =============================================================================
# WA Cloud API — Meta WhatsApp Cloud API (official, port 8210).
# Untuk pesan transaksional: OTP, invoice, subscription notices.
# Zero ban risk. Gunakan ini sebagai primary untuk pesan kritis.
# https://developers.facebook.com/docs/whatsapp/cloud-api
WA_CLOUD_API_URL=https://graph.facebook.com
WA_CLOUD_API_VERSION=v22.0
WA_CLOUD_API_PORT=8210
WA_CLOUD_API_TOKEN=

# =============================================================================
# Payment — Xendit
# =============================================================================
# https://dashboard.xendit.co/
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# =============================================================================
# Notification SMTP
# =============================================================================
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# Internal Service URLs (untuk docker-compose override)
# =============================================================================
# Service-to-service communication (default: localhost untuk dev)
# Override ini di docker-compose.yml menggunakan nama container
ACCOUNTING_URL=http://localhost:8201
AI_GATEWAY_URL=http://localhost:8002/v1/chat
WA_GATEWAY_URL=http://localhost:8202

# =============================================================================
# Testing / Development
# =============================================================================
# Nomor WA untuk testing notifikasi
TEST_WA_NUMBER=6281234567890
# Tenant ID untuk system notifications
WA_SYSTEM_TENANT_ID=

# =============================================================================
# n8n Workflow Engine (Queue Mode — PostgreSQL + Redis)
# =============================================================================
# Basic auth untuk n8n UI (exposed di http://localhost:5678)
# JANGAN pakai default di production!
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=ganti_password_n8n_yang_kuat
# Chat ID Telegram owner untuk daily revenue digest
OWNER_TELEGRAM_CHAT_ID=

# =============================================================================
# N8N Queue Mode — Horizontal Scaling
# =============================================================================
# Mode: queue (default) enables Redis-based job distribution to workers
# Workers: jumlah n8n-worker containers (default: 3)
N8N_WORKER_REPLICAS=3
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
N8N_WORKER_CONCURRENCY=10

# =============================================================================
# N8N Persistence — Dedicated Database
# =============================================================================
# N8N menggunakan database PostgreSQL TERPISAH dari platform (wch_n8n_db).
# Database ini dibuat otomatis oleh infra/postgres/init.sql saat postgres
# pertama kali start.
#
# Untuk backup/restore ke server production:
#   1. Backup:  pg_dump -h <host> -U wch_n8n wch_n8n_db > n8n_backup.sql
#   2. Restore: psql -h newserver -U wch_n8n -d wch_n8n_db < n8n_backup.sql
#
# ⚠️  N8N_ENCRYPTION_KEY WAJIB di-set. Simpan di vault (HashiCorp, AWS Secrets, dll).
#     Jika hilang/different, credential di DB tidak bisa didekripsi.
#     Generate: openssl rand -hex 32
# =============================================================================
N8N_ENCRYPTION_KEY=replace_with_32_byte_hex_key_generate_via_openssl_randr_hex_32
N8N_DB_NAME=wch_n8n_db
N8N_DB_HOST=127.0.0.1
N8N_DB_PORT=5433
N8N_DB_USER=postgres
N8N_DB_PASSWORD=postgres
N8N_PUBLIC_URL=http://localhost:5678
N8N_INTERNAL_URL=http://n8n-main:5678/

# =============================================================================
# Subscription Worker (freeze cron)
# =============================================================================
FREEZE_CHECK_INTERVAL=1h
GRACE_PERIOD_HOURS=0

# =============================================================================
# Chatwoot — Human Support Agent (Self-Hosted)
# =============================================================================
# Self-hosted Chatwoot for CS escalation
# Akses UI di: http://localhost:3000
CHATWOOT_SECRET_KEY=replace_with_lengthy_secure_hex_min_64_chars
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=1

# =============================================================================
# Messaging Gateway — Multi-Channel
# =============================================================================
# Centralized gateway for WA, Telegram, Web Chat, Instagram DM
MESSAGING_GATEWAY_PORT=8210
TELEGRAM_BOT_TOKEN_GATEWAY=
INSTAGRAM_ACCESS_TOKEN=

# =============================================================================
# Telegram Bot — Auth (Register & Login via Telegram)
# =============================================================================
# Buat bot via @BotFather di Telegram, dapatkan token.
# Bot ini digunakan untuk mengirim OTP registrasi & login.
# Webhook URL: POST https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/auth/telegram/webhook
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Observability — Grafana / Prometheus / Loki
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=ganti_password_grafana_yang_kuat   # WAJIB ganti di prod!
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=336h                                     # 14 hari (sudah ada)

# Frontend (superadmin-web)
VITE_GRAFANA_URL=http://localhost:3001                  # dev
# PRODUCTION: VITE_GRAFANA_URL=https://grafana.yourdomain.com
