# =============================================================================
# WCH Platform — Environment Variables Template
# =============================================================================
# CARA PAKAI:
#   cp .env.example .env
#   Isi nilai yang sesuai di .env
#   JANGAN commit file .env ke git!
# =============================================================================

# =============================================================================
# Core Security (WAJIB diganti sebelum production!)
# =============================================================================
APP_ENV=development                          # development | production
JWT_SECRET=ganti_ini_dengan_32_karakter_random_aman
ENCRYPTION_KEY=ganti_ini_dengan_32_karakter_random_aman

# =============================================================================
# Database — PostgreSQL
# =============================================================================
# Local (docker-compose expose ke port 5433)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=wch_admin
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=wch_platform
DB_SSLMODE=disable

# =============================================================================
# Cache — Redis
# =============================================================================
# Local (docker-compose expose ke port 6381)
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=ganti_dengan_password_kuat

# =============================================================================
# AI / LLM Gateway
# =============================================================================
# MiniMax M2.7 (LLM utama platform) — https://www.minimax.io/
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# Fallback LLM (opsional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# AI Caching via Redis
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=600

# =============================================================================
# WhatsApp Gateway
# =============================================================================
# Self-hosted WA gateway (whatsmeow-based, port 8202).
# Tenant connect via scan QR — lihat docs/WHATSAPP_GATEWAY_PLAN.md.
WA_GATEWAY_URL=http://wa-gateway:8202

# =============================================================================
# Payment — Xendit
# =============================================================================
# https://dashboard.xendit.co/
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# =============================================================================
# Notification SMTP
# =============================================================================
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# Internal Service URLs (untuk docker-compose override)
# =============================================================================
# Service-to-service communication (default: localhost untuk dev)
# Override ini di docker-compose.yml menggunakan nama container
ACCOUNTING_URL=http://localhost:8201
AI_GATEWAY_URL=http://localhost:8002/v1/chat
WA_GATEWAY_URL=http://localhost:8202

# =============================================================================
# Testing / Development
# =============================================================================
# Nomor WA untuk testing notifikasi
TEST_WA_NUMBER=6281234567890
# Tenant ID untuk system notifications
WA_SYSTEM_TENANT_ID=

# =============================================================================
# n8n Workflow Engine (Queue Mode — lihat N8N Queue Mode section di bawah)
# =============================================================================
# Basic auth untuk n8n UI (exposed di http://localhost:5678)
# JANGAN pakai default di production!
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=ganti_password_n8n_yang_kuat
# Chat ID Telegram owner untuk daily revenue digest
OWNER_TELEGRAM_CHAT_ID=

# =============================================================================
# Subscription Worker (freeze cron)
# =============================================================================
FREEZE_CHECK_INTERVAL=1h
GRACE_PERIOD_HOURS=0

# =============================================================================
# N8N Queue Mode — Horizontal Scaling
# =============================================================================
# Mode: queue (default) enables Redis-based job distribution to workers
# Workers: jumlah n8n-worker containers (default: 3)
N8N_WORKER_REPLICAS=3
N8N_WEBHOOK_URL=http://n8n-main:5678/
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
N8N_WORKER_CONCURRENCY=10

# =============================================================================
# Chatwoot — Human Support Agent (Self-Hosted)
# =============================================================================
# Self-hosted Chatwoot for CS escalation
# Akses UI di: http://localhost:3000
CHATWOOT_SECRET_KEY=replace_with_lengthy_secure_hex_min_64_chars
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=1

# =============================================================================
# Messaging Gateway — Multi-Channel
# =============================================================================
# Centralized gateway for WA, Telegram, Web Chat, Instagram DM
MESSAGING_GATEWAY_PORT=8210
TELEGRAM_BOT_TOKEN_GATEWAY=
INSTAGRAM_ACCESS_TOKEN=
