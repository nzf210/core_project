# =============================================================================
# WCH Platform — Staging Environment Variables
# =============================================================================
# CARA PAKAI:
#   1. cp .env.staging.example .env.staging
#   2. Generate secret kuat untuk setiap key (lihat instruksi di bawah)
#   3. Isi credentials API eksternal (Xendit, Telegram, LLM)
#   4. JANGAN commit file .env.staging ke git!
# =============================================================================

# =============================================================================
# Core Security — WAJIB DIGANTI!
# =============================================================================
# Generate dengan: openssl rand -base64 32 | head -c 32
# PENTING: JWT_SECRET dan ENCRYPTION_KEY harus TEPAT 32 karakter!
APP_ENV=production
JWT_SECRET=REPLACE_32_CHAR_JWT_SECRET_HERE
ENCRYPTION_KEY=REPLACE_32_CHAR_ENCRYPT_KEY_HER
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPERADMIN_PASSWORD

# =============================================================================
# Database — PostgreSQL (Production)
# =============================================================================
# CATATAN: DB_HOST=pgbouncer adalah nama service di docker network.
# Di staging VPS, docker-compose resolve 'pgbouncer' ke container internal.
# Port 6432 = pgbouncer internal port (konsisten dengan production).
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=wch_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=wch_platform
DB_SSLMODE=disable

# =============================================================================
# Cache — Redis (Production)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# =============================================================================
# AI / LLM Gateway — Primary: Anthropic Claude
# =============================================================================
# Untuk staging, pakai model yang sama dengan production.
# Cost per-request kecil, fokus ke correctness.
MINIMAX_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
MINIMAX_BASE_URL=https://api.anthropic.com/v1
MINIMAX_MODELS=claude-sonnet-4-5
MINIMAX_CAPABILITIES=general,product,faq
MINIMAX_CONTEXT_WINDOW=1000000
MINIMAX_COST_PER_1M_IN=0.30
MINIMAX_COST_PER_1M_OUT=1.20
MINIMAX_FALLBACK_1=gemini:gemini-1.5-flash
MINIMAX_FALLBACK_2=
MINIMAX_FALLBACK_3=

# Secondary LLM (OpenAI) — opsional untuk staging
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini
OPENAI_CAPABILITIES=general
OPENAI_CONTEXT_WINDOW=128000
OPENAI_COST_PER_1M_IN=0.15
OPENAI_COST_PER_1M_OUT=0.60
OPENAI_FALLBACK_1=

# Fallback LLM (Gemini) — gratis, fallback terakhir
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-1.5-flash
GEMINI_CAPABILITIES=general
GEMINI_CONTEXT_WINDOW=1000000
GEMINI_COST_PER_1M_IN=0.075
GEMINI_COST_PER_1M_OUT=0.30

# AI Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=600

# =============================================================================
# WhatsApp — Hybrid Architecture
# =============================================================================
# Gateway URL internal (docker network)
WA_GATEWAY_URL=http://wa-gateway:8202

# Meta WhatsApp Cloud API (official)
WA_CLOUD_API_URL=https://graph.facebook.com
WA_CLOUD_API_VERSION=v22.0
WA_CLOUD_API_PORT=8210
WA_CLOUD_API_TOKEN=REPLACE_WITH_META_CLOUD_API_TOKEN

# System tenant ID untuk OTP baru (before tenant exists)
WA_SYSTEM_TENANT_ID=system

# =============================================================================
# Payment — Xendit
# =============================================================================
# Staging: gunakan test mode keys dari dashboard Xendit.
# https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_API_KEY=xnd_development_REPLACE_WITH_TEST_KEY
XENDIT_WEBHOOK_TOKEN=REPLACE_WITH_STAGING_WEBHOOK_TOKEN

# =============================================================================
# Notification — Telegram Bot
# =============================================================================
# Bot token untuk notifikasi (daily digest, alerts, etc)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN_GATEWAY=REPLACE_WITH_TELEGRAM_BOT_TOKEN
OWNER_TELEGRAM_CHAT_ID=REPLACE_WITH_OWNER_CHAT_ID

# =============================================================================
# Email — SMTP (untuk notifikasi email)
# =============================================================================
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD

# =============================================================================
# Chatwoot — Live Chat & Escalation
# =============================================================================
# Self-hosted atau cloud: https://app.chatwoot.com
CHATWOOT_FRONTEND_URL=https://chatwoot.staging.wch.example.com
CHATWOOT_SECRET_KEY=REPLACE_WITH_LENGTHY_SECURE_HEX_MIN_64_CHARS
CHATWOOT_API_KEY=REPLACE_WITH_CHATWOOT_API_KEY
CHATWOOT_ACCOUNT_ID=1

# =============================================================================
# Messaging Gateway — Meta WhatsApp Cloud API / Instagram DM
# =============================================================================
MESSAGING_GATEWAY_PORT=8210
INSTAGRAM_ACCESS_TOKEN=

# =============================================================================
# N8N Workflow Engine — Queue Mode
# =============================================================================
# CRITICAL: N8N_ENCRYPTION_KEY harus SAMA di backup dan restore.
# Jika berbeda, semua credentials di DB tidak bisa didekripsi.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY_OPENSSL_RAND_HEX_32
N8N_DB_NAME=wch_n8n
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_USER=wch_admin
N8N_DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=REPLACE_WITH_STRONG_N8N_PASSWORD
N8N_PUBLIC_URL=https://stg-n8n.umkmai.id
N8N_INTERNAL_URL=http://n8n-main:5678/
N8N_PROTOCOL=https
N8N_HOST=stg-n8n.umkmai.id
N8N_WORKER_REPLICAS=2
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
N8N_WORKER_CONCURRENCY=10

# =============================================================================
# Observability — Grafana / Prometheus / Loki
# =============================================================================
# CATATAN: docker-compose.yml dan docker-compose.prod.yml pakai GRAFANA_ADMIN_PASS
# Kedua key didefinisikan agar kompatibel dengan semua compose file
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=90d
LOKI_RETENTION=336h

# Frontend (superadmin-web) — URL Grafana yang diakses dari browser
# VITE_GRAFANA_URL di-inject saat build, ubah sesuai domain staging
VITE_GRAFANA_URL=https://stg-grf.umkmai.id

# =============================================================================
# Subscription Worker
# =============================================================================
FREEZE_CHECK_INTERVAL=1h
GRACE_PERIOD_HOURS=0

# =============================================================================
# Internal Service URLs (Docker Network)
# =============================================================================
# Ini sudah benar untuk docker-compose staging. Jangan ubah kecuali custom setup.
ACCOUNTING_URL=http://umkm-accounting:8201
AI_GATEWAY_URL=http://ai-gateway:8002/v1/chat
WA_GATEWAY_URL=http://wa-gateway:8202

# =============================================================================
# Testing / Development (Staging-specific)
# =============================================================================
# Nomor WA untuk testing notifikasi di staging
TEST_WA_NUMBER=6281234567890

# =============================================================================
# CHECKLIST SEBELUM DEPLOY:
# =============================================================================
# [ ] JWT_SECRET dan ENCRYPTION_KEY masing-masing TEPAT 32 karakter
# [ ] N8N_ENCRYPTION_KEY 64 karakter hex (output openssl rand -hex 32)
# [ ] DB_PASSWORD, REDIS_PASSWORD, N8N_DB_PASSWORD, GRAFANA_ADMIN_PASSWORD kuat (min 16 char, alphanumeric + symbol)
# [ ] XENDIT_API_KEY staging/test mode dari dashboard
# [ ] TELEGRAM_BOT_TOKEN valid dari BotFather
# [ ] MINIMAX_API_KEY (Anthropic) aktif
# [ ] GEMINI_API_KEY aktif (fallback gratis)
# [ ] WA_CLOUD_API_TOKEN valid dari Meta Business
# [ ] File .env.staging TIDAK ter-commit ke git (cek .gitignore)
# =============================================================================
